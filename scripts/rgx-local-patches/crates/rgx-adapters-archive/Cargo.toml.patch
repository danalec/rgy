+
+# The package carries the rgy's own name on the registry, and the upstream's
+# name in the code: the crate a dependant sees is the crate the upstream
+# wrote, under the name its own code says (`rgx_adapters_archive::`). The sources are
+# the upstream's byte for byte, and the name in the code is part of that.
+[lib]
+name = "rgx_adapters_archive"
 
 [features]
 # Every adapter answers one format, so every format gets one feature and a
@@ -84,10 +91,10 @@
 # A git bundle and a Subversion dump are read through the git-pack reader.
 git-bundle = ["std", "git-pack", "rgx-core/zlib"]
 svn-dump = ["std", "git-pack", "rgx-core/zlib"]
-# The decompressor is the only user of libzstd: it is the oracle the
-# in-house zstd decoder is measured against, and the fallback for the one
-# frame shape the in-house decoder declines.
-decompress = ["std", "dep:zstd", "rgx-core/gzip", "rgx-core/zlib", "rgx-core/bzip2", "rgx-core/xz", "rgx-core/lzma", "rgx-core/zstd"]
+# The decompressor reads the single-file formats, and every one of them
+# through the in-house decoder in rgx-core: gzip, zlib, bzip2, xz, legacy
+# lzma and zstd.
+decompress = ["std", "rgx-core/gzip", "rgx-core/zlib", "rgx-core/bzip2", "rgx-core/xz", "rgx-core/lzma", "rgx-core/zstd"]
 # The RAR codec is the only user of `rar-codec`.
 rar = ["std", "dep:rar-codec"]
 pgdump = ["std"]
