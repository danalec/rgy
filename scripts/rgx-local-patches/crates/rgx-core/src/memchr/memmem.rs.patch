 use core::fmt;
 
+/// The biggest jump a jump table entry can hold.
+///
+/// A jump that is *smaller* than the one the table asks for is still safe --
+/// it steps over fewer windows -- so the cap costs speed and nothing else.
+const MAX_JUMP: u8 = u8::MAX;
+
+/// The jump, capped at what a table entry can hold.
+#[inline]
+fn cap(jump: usize) -> u8 {
+    if jump > MAX_JUMP as usize {
+        MAX_JUMP
+    } else {
+        jump as u8
+    }
+}
+
+/// The forward jump table.
+///
+/// `table[c]` is how far the window may move when it ends in `c`: the
+/// distance from the needle's *last* copy of `c` to the needle's end, or
+/// the needle's whole length when the needle holds no copy of `c`.
+///
+/// The needle's last byte is deliberately not in the table, and that is what
+/// makes the jump safe. A window that ends in the needle's own last byte is
+/// stepped over by exactly one window -- the byte is not in the table, and
+/// a byte that is not in the table moves the window by the needle's whole
+/// length -- and never by more.
+fn forward_table(needle: &[u8]) -> [u8; 256] {
+    let m = needle.len();
+    let mut table = [cap(m); 256];
+    // The last write wins, and the last write is the *largest* offset, which
+    // is the needle's last copy of the byte.
+    for (i, &b) in needle.iter().enumerate().take(m.saturating_sub(1)) {
+        table[b as usize] = cap(m - 1 - i);
+    }
+    table
+}
+
+/// The backward jump table.
+///
+/// The mirror of [`forward_table`]: `table[c]` is how far the window may
+/// move *down* when it starts in `c`, and the needle's *first* byte is the
+/// one that is not in the table.
+fn backward_table(needle: &[u8]) -> [u8; 256] {
+    let m = needle.len();
+    let mut table = [cap(m); 256];
+    // The last write wins, and the walk is backwards, so the last write is
+    // the *smallest* offset -- the needle's first copy of the byte.
+    for (i, &b) in needle.iter().enumerate().skip(1).rev() {
+        table[b as usize] = cap(i);
+    }
+    table
+}
+
+/// The needle's rarest byte and where it sits.
+///
+/// The needle's own bytes decide the jump, and the *rarest* of them decides
+/// whether the window is worth comparing at all. It is the same choice the
+/// pair scanner makes -- [`crate::frequency::rarest_pair`] is a port of the
+/// upstream selection, tie-break included -- so the two paths filter on the
+/// same byte.
+fn rare_byte(needle: &[u8]) -> (usize, u8) {
+    match crate::frequency::rarest_pair(needle) {
+        Some(pair) => (pair.first, needle[pair.first]),
+        None => (0, needle.first().copied().unwrap_or(0)),
+    }
+}
+
+/// The first occurrence of `needle` in `haystack`, by the jump table.
+///
+/// This is the portable search: it is what runs where the pair scanner has
+/// no vector to work with.
+fn horspool_find(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    let m = needle.len();
+    if m == 0 {
+        return Some(0);
+    }
+    if haystack.len() < m {
+        return None;
+    }
+    let table = forward_table(needle);
+    let (rare_at, rare) = rare_byte(needle);
+    let limit = haystack.len() - m;
+    let mut at = 0usize;
+    while at <= limit {
+        if haystack[at + rare_at] == rare && haystack[at..at + m] == *needle {
+            return Some(at);
+        }
+        at += table[haystack[at + m - 1] as usize] as usize;
+    }
+    None
+}
+
+/// The last occurrence of `needle` in `haystack`, by the jump table.
+///
+/// The mirror of [`horspool_find`]: the window is aligned by its first
+/// byte, and the jump table is the one built over the needle's bytes except
+/// its first.
+fn horspool_rfind(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    let m = needle.len();
+    if m == 0 {
+        return Some(haystack.len());
+    }
+    if haystack.len() < m {
+        return None;
+    }
+    let table = backward_table(needle);
+    let (rare_at, rare) = rare_byte(needle);
+    let mut at = haystack.len() - m;
+    loop {
+        if haystack[at + rare_at] == rare && haystack[at..at + m] == *needle {
+            return Some(at);
+        }
+        let step = table[haystack[at] as usize] as usize;
+        if step > at {
+            return None;
+        }
+        at -= step;
+    }
+}
