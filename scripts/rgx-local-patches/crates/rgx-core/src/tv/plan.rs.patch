+    /// The lock the ablation switch's writers hold, taken by a test that
+    /// reads the switch's effect.
+    ///
+    /// The switch is process-global, so a reader that does not hold the
+    /// lock can see it flipped in the middle of its own test — the plan
+    /// comes out under the ablation's rules while the test means the
+    /// ordinary ones. The acquisition tolerates a poisoned lock: a panic
+    /// in one test must not cascade into every later holder of the same
+    /// lock, and what the lock guards is a `()`, so there is nothing a
+    /// poisoned lock could have left inconsistent.
+    fn ablate_guard() -> std::sync::MutexGuard<'static, ()> {
+        crate::ABLATE_EXTENTS_LOCK
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+    }
+
