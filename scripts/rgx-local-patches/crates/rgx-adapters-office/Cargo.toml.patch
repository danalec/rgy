--- a/crates/rgx-adapters-office/Cargo.toml
+++ b/crates/rgx-adapters-office/Cargo.toml
@@ -1,6 +1,6 @@
 [package]
 name = "rgx-adapters-office"
-version = "0.1.1"
+version = "0.1.2"
 edition = "2021"
 authors = ["Dan Alec Yamaguchi <danalec@gmail.com>"]
 description = "rgx adapters for Office/OpenDocument/e-book containers, parsed in-process (zip + XML strip, no external tools)"
@@ -8,7 +8,7 @@
 readme = "README.md"
 keywords = ["docx", "xlsx", "pptx", "rtf", "visio"]
 categories = ["parser-implementations", "encoding"]
-repository = "https://github.com/danalec/rgx"
+repository = "https://github.com/danalec/rgy"
 # What the published crate carries. The test corpus is the repository's:
 # the fixtures under `testdata/` are what this crate's own tests read, and
 # a user of the crate has no use for them. The examples are one-off
@@ -49,10 +49,10 @@
 hwp = ["rgx-core/zlib"]
 wordperfect = []
 [dependencies]
-rgx-core = { path = "../rgx-core", version = "0.1.1", default-features = false, features = ["std", "sha256-hw"] }
+rgx-core = { path = "../rgx-core", version = "0.1.2", default-features = false, features = ["std", "sha256-hw"] }
 # The zip reader in `lib.rs` spends the same producer budget as the
 # archive crate's own zip adapter (`budget::MemberSink`), so a `.docx` is
 # capped by `-M` / RGX_MAX_MEMBER_BYTES like every other container.
 # Optional: only the `office` family spends that budget, and it switches
 # off with it.
-rgx-adapters-archive = { path = "../rgx-adapters-archive", version = "0.1.1", default-features = false, optional = true }
+rgx-adapters-archive = { path = "../rgx-adapters-archive", version = "0.1.2", default-features = false, optional = true }
