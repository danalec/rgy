@@ -27,6 +27,13 @@
     "/LICENSE-APACHE",
     "/NOTICE",
 ]
+
+# The package carries the rgy's own name on the registry, and the upstream's
+# name in the code: the crate a dependant sees is the crate the upstream
+# wrote, under the name its own code says (`rgx_adapters_office::`). The sources are
+# the upstream's byte for byte, and the name in the code is part of that.
+[lib]
+name = "rgx_adapters_office"
 
 [features]
 # One feature per adapter, in the order `adapters()` returns them. The
@@ -49,10 +56,10 @@
 hwp = ["rgx-core/zlib"]
 wordperfect = []
