--- a/crates/rgx-adapters-docs/Cargo.toml
+++ b/crates/rgx-adapters-docs/Cargo.toml
@@ -1,6 +1,6 @@
 [package]
-name = "rgx-adapters-docs"
-version = "0.1.9"
+name = "rgy-vendored-adapters-docs"
+version = "0.1.10"
 edition = "2021"
 authors = ["Dan Alec Yamaguchi <danalec@gmail.com>"]
 description = "rgx adapters that shell out to external tools (soffice, tesseract) when present on PATH"
@@ -8,7 +8,7 @@
 readme = "README.md"
 keywords = ["markdown", "latex", "docbook", "markup"]
 categories = ["parser-implementations", "text-processing"]
-repository = "https://github.com/danalec/rgx"
+repository = "https://github.com/danalec/rgy"
 # What the published crate carries. The test corpus is the repository's:
 # the fixtures under `testdata/` are what this crate's own tests read, and
 # a user of the crate has no use for them. The examples are one-off
@@ -27,6 +27,13 @@
     "/LICENSE-APACHE",
     "/NOTICE",
 ]
+
+# The package carries the rgy's own name on the registry, and the upstream's
+# name in the code: the crate a dependant sees is the crate the upstream
+# wrote, under the name its own code says (`rgx_adapters_docs::`). The sources are
+# the upstream's byte for byte, and the name in the code is part of that.
+[lib]
+name = "rgx_adapters_docs"
 
 [features]
 # One feature per adapter, in the order `adapters()` returns them: the
@@ -47,17 +54,17 @@
 ocr = ["dep:rgx-adapters-pdf", "rgx-adapters-pdf/pdf"]
 
 [dependencies]
-rgx-core = { path = "../rgx-core", version = "0.1.9", default-features = false, features = ["std", "sha256-hw"] }
+rgx-core = { path = "../rgx-core", version = "0.1.10", default-features = false, features = ["std", "sha256-hw"], package = "rgy-vendored-core" }
 # for `xml_to_text` only: the soffice adapter converts to flat ODF (see
 # Soffice::extract) and this is the tree's one XML → text pass. Compile-time
 # only -- `rgx-adapters-office` reaches the registry through the root's own
 # `adapters-office` feature, which this dependency does not imply.
 # Optional: only the `soffice` family needs it, and it switches off
 # with it.
-rgx-adapters-office = { path = "../rgx-adapters-office", version = "0.1.9", default-features = false, optional = true }
+rgx-adapters-office = { path = "../rgx-adapters-office", version = "0.1.10", default-features = false, optional = true, package = "rgy-vendored-adapters-office" }
 # for `pages_of_a_pdf` only: the ocr adapter claims `ocr.pdf`, and tesseract
 # refuses a PDF unless its build supports PDF input, so a scanned PDF is
 # opened here and its page images handed over instead (see the fn).
 # Optional: only the `ocr` family needs it, and it switches off with
 # it.
-rgx-adapters-pdf = { path = "../rgx-adapters-pdf", version = "0.1.9", default-features = false, optional = true }
+rgx-adapters-pdf = { path = "../rgx-adapters-pdf", version = "0.1.10", default-features = false, optional = true, package = "rgy-vendored-adapters-pdf" }
